# ZT Agent Proxy — environment variables
# All optional; CLI flags override.

# Proxy
ZT_PROXY_HOST=127.0.0.1
ZT_PROXY_PORT=8000
ZT_MGMT_PORT=8080
ZT_RATE_LIMIT=60

# Management API bearer token (uncomment to require auth)
# ZT_MGMT_TOKEN=change-this-to-a-long-random-string

# Data directory for SQLite audit chain + forensics.jsonl
# ZT_DATA_DIR=./.data

# Policy file (JSON: actions, domains, rate_limit_per_min)
# ZT_POLICY_FILE=./policy.json

# Per-category actions: block | warn | log
# ZT_ACTION_INJECTION=warn
# ZT_ACTION_PII=block
# ZT_ACTION_SECRET=block
# ZT_ACTION_VULN=block

# Domain lists (comma-separated)
# ZT_ALLOW_DOMAINS=api.openai.com,api.anthropic.com
# ZT_BLOCK_DOMAINS=tracker.example

ZT_LOG_LEVEL=INFO
